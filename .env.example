# Ivy Configuration

# General Application Settings
IVY_APP_NAME=ivy
DEFAULT_MODEL=gpt-4o-mini
IVY_DB_PATH=./ivy.db
SKILLS_DIR=skills
LOG_LEVEL=INFO
VERBOSE=false

# LLM Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
LITELLM_API_BASE=
IVY_API_BASE=

# TUI & Agent Runtime
IVY_THEME=ivy
MAX_ITERATIONS=50
IVY_LLM_MAX_RETRIES=2
IVY_LLM_RETRY_BASE_DELAY=0.5
IVY_FALLBACK_MODEL=
IVY_AUTO_COMPACT_THRESHOLD=0.85

# Multi-Platform Gateway & Security Whitelist
ALLOWED_USERS=12345678,user_id_2
TELEGRAM_TOKEN=
DISCORD_TOKEN=

# Safety & Autonomous Execution
AUTO_APPROVE_SAFETY=false
